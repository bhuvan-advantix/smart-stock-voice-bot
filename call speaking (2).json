    {
      "parameters": {
        "jsCode": "// Parsing node - extracts SpeechResult, detects intent, extracts SKU safely\n\n// 1️⃣ Get input data safely\nconst items = $input.all();\nconst rawJson = (items[0] && items[0].json) || {};\nconst incoming = rawJson.body || rawJson || {};\n\n// 2️⃣ Extract Twilio SpeechResult safely\nlet speechResult = \"\";\nif (incoming.SpeechResult) {\n  speechResult = String(incoming.SpeechResult).trim();\n}\n\n// 3️⃣ Lowercase for intent matching\nconst speechLower = speechResult.toLowerCase();\n\n// 4️⃣ Detect intent\nlet intent = \"unknown\";\nif (speechLower.includes(\"stock\")) {\n  intent = \"stock\";\n} else if (speechLower.includes(\"hour\") || speechLower.includes(\"open\")) {\n  intent = \"hours\";\n} else if (speechLower.includes(\"emi\")) {\n  intent = \"emi\";\n} else if (\n  speechLower.includes(\"agent\") ||\n  speechLower.includes(\"support\") ||\n  speechLower.includes(\"human\")\n) {\n  intent = \"agent\";\n} else if (!speechResult) {\n  intent = \"empty\";\n}\n\n// 5️⃣ Extract SKU like P1 / P12 / P001\nlet sku = null;\nconst skuMatch = speechResult.match(/p\\s*(\\d{1,4})/i);\nif (skuMatch && skuMatch[1]) {\n  let digits = skuMatch[1];\n  if (digits.length < 3) digits = digits.padStart(3, \"0\"); // P1 -> P001, P12 -> P012\n  sku = \"P\" + digits;\n}\n\n// 6️⃣ Debug logs (visible in n8n executions)\nconsole.log(\"Incoming SpeechResult:\", speechResult);\nconsole.log(\"Detected intent:\", intent, \"Detected SKU:\", sku);\n\n// 7️⃣ Return structured JSON for next nodes\nreturn [\n  {\n    json: {\n      speechResult,\n      intent,\n      sku,\n      rawTwilio: incoming,\n    },\n  },\n];\n"
      },
