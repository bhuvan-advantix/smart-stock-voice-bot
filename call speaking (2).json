      "parameters": {
        "jsCode": "// Stock response Code node\nconst items = $input.all();\nlet row = {};\n\n// 1️⃣ Safely get DB row\n// If the DB node returns an array inside `data` or as a single object\nif (items[0]?.json?.data && Array.isArray(items[0].json.data) && items[0].json.data.length > 0) {\n    row = items[0].json.data[0];  // first row from array\n} else if (items[0]?.json) {\n    row = items[0].json;\n}\n\n// 2️⃣ Get SKU and stock safely\nconst sku = row.sku || $json?.sku || 'the requested product';\nconst stock = parseInt(row.on_hand?.toString?.() || '0', 10);\n\n// 3️⃣ Generate TwiML\nlet twiml = '';\nif (!row || Object.keys(row).length === 0) {\n    twiml = `<Response><Say>Sorry, I could not find product ${sku} in inventory.</Say><Hangup/></Response>`;\n} else if (stock > 0) {\n    twiml = `<Response><Say>The product ${sku} has ${stock} unit${stock === 1 ? '' : 's'} in stock.</Say><Hangup/></Response>`;\n} else {\n    twiml = `<Response><Say>I'm sorry, the product ${sku} is currently out of stock.</Say><Hangup/></Response>`;\n}\n\n// 4️⃣ Return TwiML with headers\nreturn [\n    {\n        json: {\n            body: twiml,\n            headers: { \"Content-Type\": \"application/xml\" }\n        }\n    }\n];\n"
      },
      "type": "n8n-nodes-base.code",
