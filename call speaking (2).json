        "jsCode": "// Code4 - initial prompt (replace entirely)\nconst MAIN_WEBHOOK_URL = 'https://n8nbnnnnnnnnn.app.n8n.cloud/webhook/e9c642ee-ebfd-444d-b789-ece3bb8a9025';\n\nconst twiml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Gather input=\"speech\" action=\"${MAIN_WEBHOOK_URL}\" method=\"POST\" speechTimeout=\"auto\" language=\"en-IN\">\n    <Say>Please tell me the product code or ask about stock, store hours, or EMI options.</Say>\n  </Gather>\n  <Say>We didn't hear anything. Please call again. Goodbye.</Say>\n  <Hangup/>\n</Response>`;\n\nreturn [{ json: { body: twiml } }];\n"
