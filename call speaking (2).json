    {
      "parameters": {
        "jsCode": "// Store Hours response Code node\nconst items = $input.all();\nlet data = {};\n\n// 1️⃣ Safely get the DB row\nif (items[0]?.json?.data && Array.isArray(items[0].json.data) && items[0].json.data.length > 0) {\n    data = items[0].json.data[0]; // first row from array\n} else if (items[0]?.json) {\n    data = items[0].json;\n}\n\n// 2️⃣ Get hours safely, with fallback\nconst hours = data.value || \"9 AM to 5 PM\";\n\n// 3️⃣ Generate TwiML\nconst twiml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Say>Our store hours are ${hours}, Monday through Saturday.</Say>\n  <Hangup/>\n</Response>`;\n\n// 4️⃣ Return TwiML with proper headers\nreturn [\n    {\n        json: {\n            body: twiml,\n            headers: { \"Content-Type\": \"application/xml\" }\n        }\n    }\n];\n"
      },
