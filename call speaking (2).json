        "jsCode": "// Pass-through Code node for responding to Twilio\nconst inputItems = $input.all();\nconst inputData = inputItems[0]?.json || {};\n\n// 1️⃣ Ensure body and headers exist\nconst body = inputData.body || \"\";\nconst headers = inputData.headers || { \"Content-Type\": \"application/xml\" };\nconst statusCode = inputData.statusCode || 200;\n\n// 2️⃣ Return response to Respond to Webhook node\nreturn [\n  {\n    json: {\n      body,\n      headers,\n      statusCode\n    }\n  }\n];\n"
