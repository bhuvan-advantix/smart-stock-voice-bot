      "parameters": {
        "jsCode": "// EMI response Code node\nconst items = $input.all();\nlet data = {};\n\n// 1️⃣ Safely get the DB row\nif (items[0]?.json?.data && Array.isArray(items[0].json.data) && items[0].json.data.length > 0) {\n    data = items[0].json.data[0]; // first row from array\n} else if (items[0]?.json) {\n    data = items[0].json;\n}\n\n// 2️⃣ Get EMI info safely, with fallback\nconst emi = data.value || \"We offer 3, 6, and 12 month EMI plans.\";\n\n// 3️⃣ Generate TwiML\nconst twiml = `<Response>\n  <Say>Regarding EMI options: ${emi}</Say>\n  <Hangup/>\n</Response>`;\n\n// 4️⃣ Return TwiML with proper headers\nreturn [\n    {\n        json: {\n            body: twiml,\n            headers: { \"Content-Type\": \"application/xml\" }\n        }\n    }\n];\n"
